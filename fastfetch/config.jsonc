{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  // Compact WSL-optimized fastfetch config.
  // Good for MOTD (profile.d) and interactive use.
  // Uses small logo + only the most relevant modules for a dev machine.

  "logo": {
    "type": "small",
    "padding": {
      "top": 0,
      "left": 1,
      "right": 3
    }
  },

  "display": {
    "separator": "  ",
    "color": {
      "title": "blue",
      "separator": "magenta"
    }
  },

  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    "separator",
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "cpu",
    {
      "type": "memory",
      "key": "Memory"
    },
    {
      "type": "disk",
      "key": "Disk /",
      "folders": "/"
    },
    {
      "type": "disk",
      "key": "Disk C",
      "folders": "/mnt/c"
    },
    {
      "type": "localip",
      "key": "IP"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
